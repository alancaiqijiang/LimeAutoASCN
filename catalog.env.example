# LimeAuto runtime and release configuration example
# Do not copy secrets or this file directly into production.

# Internal aftercare database and staff session protection.
LIMEAUTO_AFTERCARE_DB_PATH=/srv/limeauto/data/aftercare.sqlite3
LIMEAUTO_AFTERCARE_HMAC_SECRET=replace-with-a-long-random-secret
LIMEAUTO_AFTERCARE_COOKIE_SECURE=1

# Catalog is deliberately closed by default.
LIMEAUTO_CATALOG_BROWSE=0
LIMEAUTO_CATALOG_RELEASE_ALLOW_DRAFT=0

# Set only for a validated/published immutable release.
# LIMEAUTO_CATALOG_RELEASE_PATH=/srv/limeauto/artifacts/releases/catalog.sqlite
# LIMEAUTO_CATALOG_ASSET_ROOT=/srv/limeauto/artifacts/catalog-assets
# LIMEAUTO_CATALOG_TRANSLATION_PATH=/srv/limeauto/artifacts/translations/catalog_translation.sqlite
# LIMEAUTO_CATALOG_MODEL_THUMBNAIL_MAP=/srv/limeauto/artifacts/catalog-model-thumbnails/series-map.json
# LIMEAUTO_CATALOG_MODEL_THUMBNAIL_ROOT=/srv/limeauto/artifacts/catalog-model-thumbnails

# Offline qpren tools only; never used by the web request path.
# LIMEAUTO_QPREN_READ_DSN=postgresql://USER:***@127.0.0.1:15432/qpren
# LIMEAUTO_EPC_APP_ROOT=/srv/limeauto
# LIMEAUTO_EPC_CURRENT_DB=/srv/limeauto/artifacts/releases/base.sqlite
# LIMEAUTO_EPC_CURRENT_ROOT=/srv/limeauto/artifacts/catalog-assets/base
# LIMEAUTO_EPC_SOURCE_ROOT=/srv/qpren
# LIMEAUTO_EPC_OUTPUT_DB=/srv/limeauto/staging/releases/epc.sqlite
# LIMEAUTO_EPC_OUTPUT_ROOT=/srv/limeauto/staging/catalog-assets/epc
# LIMEAUTO_EPC_OUTPUT_REPORT=/srv/limeauto/staging/reports/epc.json
